{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luxshop",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-09",

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/uploads/*"
    ]
  }
}